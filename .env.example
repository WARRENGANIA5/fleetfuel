SECRET_KEY=change-this-to-a-random-secret-key
# Firebase Firestore: the service account key of the Firebase project
# (Firebase console > Project settings > Service accounts > Generate new private key),
# saved as firebase-key.json in this folder. Another location:
# FIREBASE_CREDENTIALS=C:\path\to\key.json
# Online hosting without files: paste the whole key JSON on one line instead:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
